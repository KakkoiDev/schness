{
  "schemaVersion": 1,
  "scorePerspective": "values are player A positive; results use the root player's perspective",
  "games": {
    "horizon": {"root":"root","nodes":{
      "root":{"turn":"A","next":{"greedy":"trap","safe":"safe"}},
      "trap":{"turn":"B","value":10,"next":{"reply":"loss"}},
      "safe":{"turn":"B","value":2,"next":{"reply":"draw"}},
      "loss":{"turn":"A","terminal":-100},"draw":{"turn":"A","terminal":0}
    }},
    "extra-turn": {"root":"root","nodes":{
      "root":{"turn":"A","next":{"extra":"again","finish":"end"}},
      "again":{"turn":"A","next":{"win":"win","blunder":"loss"}},
      "end":{"turn":"B","terminal":10},"win":{"turn":"B","terminal":100},"loss":{"turn":"B","terminal":-100}
    }},
    "black-root": {"root":"root","nodes":{
      "root":{"turn":"B","next":{"good":"negative","bad":"positive"}},
      "negative":{"turn":"A","terminal":-20},"positive":{"turn":"A","terminal":10}
    }},
    "tie": {"root":"root","nodes":{
      "root":{"turn":"A","next":{"left":"one","right":"two","worse":"three"}},
      "one":{"turn":"B","terminal":7},"two":{"turn":"B","terminal":7},"three":{"turn":"B","terminal":-3}
    }},
    "terminal": {"root":"end","nodes":{"end":{"turn":"B","terminal":13}}},
    "danger": {"root":"root","nodes":{
      "root":{"turn":"A","next":{"tempting":"checked","safe":"end"}},
      "checked":{"turn":"B","value":100,"danger":true,"next":{"forced":"loss"}},
      "loss":{"turn":"A","terminal":-100},"end":{"turn":"B","terminal":5}
    }},
    "transposition": {"root":"root","nodes":{
      "root":{"turn":"A","next":{"left":"left","right":"right"}},
      "left":{"turn":"B","next":{"a":"plus","b":"shared"}},
      "right":{"turn":"B","next":{"a":"shared","b":"minus"}},
      "plus":{"turn":"A","terminal":9},"shared":{"turn":"A","terminal":3},"minus":{"turn":"A","terminal":-7}
    }}
  },
  "cases": [
